# Copy this file to .env and fill it in. .env is git-ignored.
PORT=5000

# Local MongoDB, or an Atlas connection string like
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=profile-analyzer

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173

# OpenAI API key for AI scoring. Leave empty to use keyword matching only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Job matching (background agent). Sources to search, comma-separated.
JOB_PROVIDERS=adzuna,remotive
# Remotive needs no key. Free Adzuna keys: https://developer.adzuna.com. ADZUNA_COUNTRY is a two-letter code (us, gb, in, ...).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
# The most jobs one run scores against the resume (each can be an OpenAI call).
JOB_AGENT_MAX_SCORED=25
# Job searches one user (or IP, when signed out) can start per 24 hours.
JOB_RUNS_PER_DAY=10
# Any long random string. Vercel Cron sends it to /api/cron/job-agent.
CRON_SECRET=
